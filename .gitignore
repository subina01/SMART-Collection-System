# ── Ignore everything at root by default ─────────────────────────────────────
/*

# ── Allow only the backend project folders ───────────────────────────────────
!/.gitignore
!/CollectorApp/
!/CollectorApp.Core/
!/CollectorApp.Application/
!/CollectorApp.Infrastructure/

# ── Exclude frontend (maintained in a separate repository) ────────────────────
/collector-app-frontend/

# ── .NET build artifacts ──────────────────────────────────────────────────────
**/bin/
**/obj/
**/.vs/
**/*.user

# ── Sensitive / local config ──────────────────────────────────────────────────
**/appsettings.Development.json
